{
  "name": "bootstrap-blog",
  "description": "Official blog for Bootstrap.",
  "version": "1.0.0",
  "private": true,
  "author": "The Bootstrap Authors (https://github.com/twbs/blog/graphs/contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twbs/blog.git"
  },
  "bugs": {
    "url": "https://github.com/twbs/blog/issues"
  },
  "license": "MIT",
  "homepage": "https://blog.getbootstrap.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev",
    "build": "astro build && npm run pagefind",
    "image:webp": "node scripts/convert-image.mjs",
    "pagefind": "pagefind --site dist",
    "preview": "astro preview",
    "serve-only": "sirv-cli dist --port 4000",
    "test": "npm-run-all build --parallel --continue-on-error --aggregate-output test-*",
    "test-eslint": "eslint --cache --cache-location .cache/.eslintcache .",
    "test-fusv": "fusv src/assets/scss/",
    "test-stylelint": "stylelint src/assets/scss/ --cache --cache-location .cache/.stylelintcache",
    "test-markdownlint": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" \"!**/node_modules/**\"",
    "test-linkinator": "linkinator dist --recurse --silent --skip \"^(?!http://(localhost|127\\.0\\.0\\.1))\"",
    "test-lockfile-lint": "lockfile-lint"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@pagefind/component-ui": "^1.5.2",
    "@twbs/bui": "^0.1.8",
    "astro": "^7.4.2",
    "astro-og-canvas": "^0.13.2",
    "autoprefixer": "^10.6.1",
    "bootstrap": "^6.0.0-alpha.1",
    "clipboard": "^2.0.11",
    "eslint": "^10.13.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "linkinator": "^8.1.0",
    "lockfile-lint": "^5.1.0",
    "markdownlint-cli2": "^0.24.0",
    "npm-run-all2": "^9.0.4",
    "pagefind": "^1.5.2",
    "postcss-prefix-custom-properties": "^0.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1",
    "stylelint": "16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "zod": "^4.4.3"
  }
}
