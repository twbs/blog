{
  "name": "bootstrap-blog",
  "description": "Official blog for Bootstrap.",
  "version": "1.0.0",
  "private": true,
  "author": "The Bootstrap Authors (https://github.com/twbs/blog/graphs/contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twbs/blog.git"
  },
  "bugs": {
    "url": "https://github.com/twbs/blog/issues"
  },
  "license": "MIT",
  "homepage": "https://blog.getbootstrap.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev",
    "build": "astro build && npm run pagefind",
    "pagefind": "pagefind --site dist",
    "preview": "astro preview",
    "serve-only": "sirv-cli dist --port 4000",
    "test": "npm-run-all build --parallel --continue-on-error --aggregate-output test-*",
    "test-eslint": "eslint --cache --cache-location .cache/.eslintcache .",
    "test-fusv": "fusv src/assets/scss/",
    "test-stylelint": "stylelint src/assets/scss/ --cache --cache-location .cache/.stylelintcache",
    "test-markdownlint": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "test-linkinator": "linkinator dist --recurse --silent --skip \"^(?!http://localhost)\"",
    "test-lockfile-lint": "lockfile-lint",
    "netlify": "cross-env-shell DEPLOY_PRIME_URL=$DEPLOY_PRIME_URL npm run build"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.2.0",
    "astro": "^7.0.9",
    "astro-og-canvas": "^0.13.0",
    "autoprefixer": "^10.5.4",
    "bootstrap": "file:../b6-dev",
    "bootstrap-vscode-theme": "^0.0.9",
    "clipboard": "^2.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.6.0",
    "htmlparser2": "^12.0.0",
    "js-yaml": "^5.2.2",
    "linkinator": "^7.6.1",
    "lockfile-lint": "^5.0.0",
    "markdownlint-cli2": "^0.22.0",
    "npm-run-all2": "^9.0.2",
    "pagefind": "^1.5.2",
    "postcss-prefix-custom-properties": "^0.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.101.0",
    "shiki": "^4.4.3",
    "sirv-cli": "^3.0.1",
    "stylelint": "16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "zod": "^4.4.3"
  }
}
