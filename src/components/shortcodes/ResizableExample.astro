---
import { replacePlaceholdersInHtml } from '../../libs/placeholder'
import Code from './Code.astro'

interface Props {
  /** The example markup. Arrays are joined with newlines. */
  code: string | string[]
  /** CSS class(es) for the resizable container. */
  class?: string
  /**
   * Starting width of the resizable container.
   * @default '100%'
   */
  initialWidth?: string
  /**
   * Smallest width the container can be dragged to.
   * @default '200px'
   */
  minWidth?: string
  /**
   * Show a badge naming the container query breakpoint currently in effect.
   * @default false
   */
  showBreakpoint?: boolean
  /**
   * Show the source below the preview.
   * @default true
   */
  showMarkup?: boolean
}

const {
  code,
  class: className,
  initialWidth = '100%',
  minWidth = '200px',
  showBreakpoint = false,
  showMarkup = true
} = Astro.props

const markup = replacePlaceholdersInHtml(Array.isArray(code) ? code.join('\n') : code)

// The container needs `overflow: hidden` for the CSS resize handle to work,
// which clips menus when they open. Position them fixed in the preview only so
// they can spill outside; the source listing below is left untouched.
const previewMarkup = markup.replace(
  /data-bs-toggle="menu"(?![^>]*\bdata-bs-strategy=)/g,
  'data-bs-toggle="menu" data-bs-strategy="fixed"'
)

const sourceMarkup = markup.replace(
  /<svg[^>]*class="bd-placeholder-img ?([^"]*)"[\s\S]*?<\/svg>/g,
  (_match, classes: string) => `<img src="..."${classes ? ` class="${classes}"` : ''} alt="...">`
)
---

<div class="bd-example-snippet bd-code-snippet not-prose" data-pagefind-ignore>
  <div class="bd-example bd-example-resizable bg-1">
    <div
      class:list={['bd-resizable-container bg-body border border-keyline shadow-xs', className]}
      style={`width: ${initialWidth}; min-width: ${minWidth};`}
    >
      <Fragment set:html={previewMarkup} />
      {showBreakpoint && <output class="bd-resizable-badge" data-resizable-badge aria-live="polite" />}
    </div>
  </div>
  {showMarkup && <Code code={sourceMarkup} />}
</div>

<script>
  // Breakpoints mirror `$breakpoints` in Bootstrap 6's scss/_config.scss.
  // Container queries resolve against the content-box inline size of the
  // nearest query container, so that's what gets measured.
  const breakpoints = [
    { name: 'xs', min: 0 },
    { name: 'sm', min: 576 },
    { name: 'md', min: 768 },
    { name: 'lg', min: 1024 },
    { name: 'xl', min: 1280 },
    { name: '2xl', min: 1536 }
  ]

  function activeBreakpoint(width: number) {
    return breakpoints.reduce((active, breakpoint) => (width >= breakpoint.min ? breakpoint : active), breakpoints[0])
  }

  document.querySelectorAll<HTMLElement>('[data-resizable-badge]').forEach(badge => {
    const container = badge.closest<HTMLElement>('.bd-resizable-container')

    if (!container) {
      return
    }

    // Measure the query container itself when the example nests one, so the
    // badge agrees with what `@container` evaluates.
    const target = container.querySelector<HTMLElement>(':scope > *:not(.bd-resizable-badge)') ?? container

    const observer = new ResizeObserver(entries => {
      for (const entry of entries) {
        const width = entry.contentBoxSize?.[0]?.inlineSize ?? entry.contentRect.width
        const breakpoint = activeBreakpoint(width)

        badge.dataset.breakpoint = breakpoint.name
        badge.textContent = `${breakpoint.name} · ${Math.round(width)}px`
      }
    })

    observer.observe(target, { box: 'content-box' })
  })
</script>
