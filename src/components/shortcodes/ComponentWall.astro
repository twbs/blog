---
// A frameless showcase of v6 components, spanning the full post measure rather
// than the text track. There's deliberately no source listing: the point is the
// look of the new component set, not any one snippet.
---

<div class="bd-component-wall not-prose d-flex flex-wrap align-items-center justify-content-center gap-8 my-5">
  <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
    <span class="avatar avatar-lg theme-primary">MO
      <span class="avatar-status status-online"></span>
    </span>
    <span class="avatar">
      <svg
        class="bd-placeholder-img avatar-img"
        width="40"
        height="40"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="var(--bs-bg-3)"></rect></svg>
      <span class="avatar-status status-busy"></span>
    </span>
    <span class="avatar avatar-subtle theme-accent">JD</span>
    <span class="avatar avatar-sm avatar-subtle theme-success">S</span>
    <span class="avatar avatar-xs avatar-subtle theme-info">I</span>
  </div>

  <div class="d-flex align-items-center justify-content-center gap-3">
    <span class="avatar-stack">
      <span class="avatar avatar-subtle theme-secondary">+3</span>
      <span class="avatar avatar-subtle theme-success">ef</span>
      <span class="avatar avatar-subtle theme-accent">cd</span>
      <span class="avatar avatar-subtle theme-primary">ab</span>
    </span>
  </div>


  <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
    <span class="badge theme-primary">New</span>
    <span class="badge badge-subtle theme-success">Stable</span>
    <span class="badge badge-outline theme-danger">Deprecated</span>
  </div>

  <div class="w-100 flex-1 d-none"></div>

  <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
    <button type="button" class="btn btn-sm">Base</button>
    <button type="button" class="btn-solid btn-sm theme-primary">Solid</button>
    <button type="button" class="btn-outline btn-sm theme-success">Outline</button>
    <button type="button" class="btn-subtle btn-sm theme-accent">Accent subtle</button>
    <button type="button" class="btn-text btn-sm theme-danger">Danger</button>
    <button type="button" class="btn-icon btn-sm" aria-label="Add">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10"></path></svg>
    </button>
  </div>

  <div class="w-100 flex-1 d-none"></div>

  <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
    <span class="chip">Default</span>
    <span class="chip theme-primary active">Selected</span>
    <span class="chip">
      <span class="chip-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4 5 8-8"></path></svg></span>
      With icon
    </span>
    <span class="chip theme-accent">
      <img src="https://github.com/twbs.png" alt="Bootstrap" class="chip-img">
      Avatar chip
    </span>
    <span class="chip theme-danger">
      Dismissible
      <button type="button" class="chip-dismiss" aria-label="Remove">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m4 4 8 8M12 4l-8 8"></path></svg>
      </button>
    </span>
  </div>

  <div class="w-100 flex-1 d-none"></div>

  <div class="d-flex flex-wrap align-items-center justify-content-center w-100 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a class="breadcrumb-link" href="#">Home</a>
        </li>
        <li class="breadcrumb-divider"></li>
        <li class="breadcrumb-item">
          <a class="breadcrumb-link" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentcolor"><circle cx="2" cy="8" r="2"/><circle cx="8" cy="8" r="2"/><circle cx="14" cy="8" r="2"/></svg>
          </a>
        </li>
        <li class="breadcrumb-divider"></li>
        <li class="breadcrumb-item">
          <a class="breadcrumb-link" href="#">Documents</a>
        </li>
        <li class="breadcrumb-divider"></li>
        <li class="breadcrumb-item" aria-current="page">
          <a class="breadcrumb-link active" href="#">2026</a>
        </li>
      </ol>
    </nav>
  </div>

  <div class="w-100 flex-1 d-none"></div>

  <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
    <div class="d-flex align-items-center justify-content-center">
      <button type="button" class="btn-solid btn-styled btn-sm theme-accent" data-bs-toggle="menu" aria-expanded="false">
        Menu
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 5 6 6 6-6"></path></svg>
      </button>
      <div class="menu theme-accent">
        <a class="menu-item active" href="#">Duplicate</a>
        <a class="menu-item" href="#">Rename</a>
        <a class="menu-item" href="#">Move to</a>
        <hr class="menu-divider" />
        <a class="menu-item" href="#">Delete</a>
      </div>
    </div>

    <button type="button" class="btn-solid btn-styled theme-primary btn-sm" data-bs-toggle="tooltip" data-bs-title="Placed with Floating UI">
      Hover tooltip
    </button>
    <button
      type="button"
      class="btn-solid btn-styled theme-secondary btn-sm"
      data-bs-toggle="popover"
      data-bs-title="Popover title"
      data-bs-content="No more opt-in—tooltips and popovers initialize on first interaction."
    >
      Toggle popover
    </button>
  </div>

  <div class="d-grid grid-cols-1 md:grid-cols-3 align-items-start justify-content-center gap-4 md:gap-8">
    <div class="g-col d-flex align-items-center">
      <ol class="stepper stepper-horizontal w-100 m-0">
        <li class="stepper-item active"><span class="fs-sm">Cart</span></li>
        <li class="stepper-item active"><span class="fs-sm">Shipping</span></li>
        <li class="stepper-item"><span class="fs-sm">Payment</span></li>
      </ol>
    </div>

    <div class="g-col">
      <div class="accordion accordion-sm w-100">
        <details class="accordion-item" name="accordionGallery" open>
          <summary class="accordion-header">
            Example accordion
            <svg class="accordion-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m2 5 6 6 6-6"></path></svg>
          </summary>
          <div class="accordion-body fs-sm">Open and close without JavaScript.</div>
        </details>
        <details class="accordion-item" name="accordionGallery">
          <summary class="accordion-header">
            Built on details/summary
            <svg class="accordion-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m2 5 6 6 6-6"></path></svg>
          </summary>
          <div class="accordion-body fs-sm">Opening this one closes the other.</div>
        </details>
        <details class="accordion-item" name="accordionGallery">
          <summary class="accordion-header">
            Woohoo!
            <svg class="accordion-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m2 5 6 6 6-6"></path></svg>
          </summary>
          <div class="accordion-body fs-sm">Hella nice!</div>
        </details>
      </div>
    </div>

    <div class="g-col">
      <div class="card">
        <svg
          class="bd-placeholder-img card-img-top"
          width="100%"
          height="96"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="var(--bs-bg-2)"></rect></svg>
        <div class="card-body">
          <h4 class="card-title fs-md">Card title</h4>
          <p class="card-text fs-sm mb-0">Cards pick up refreshed radii and a cleaner flexbox layout.</p>
        </div>
      </div>
    </div>
  </div>
</div>
