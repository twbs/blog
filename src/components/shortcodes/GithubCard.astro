---
export interface Props {
  repo: string
  number: number
  type: 'issue' | 'pull'
  title: string
  openedAt: string
  comments?: number
  state: 'open' | 'closed' | 'merged'
}

const { repo, number, type, title, openedAt, comments, state }: Props = Astro.props
const path = type === 'issue' ? 'issues' : 'pull'
const url = `https://github.com/${repo}/${path}/${number}`
const typeLabel = type === 'issue' ? 'Issue' : 'Pull request'
const stateLabel = state[0].toUpperCase() + state.slice(1)
const stateTheme = {
  open: 'success',
  closed: 'danger',
  merged: 'accent'
}[state]
const openedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC'
}).format(new Date(openedAt))
---

<a
  class:list={['github-card not-prose', `theme-${stateTheme}`]}
  href={url}
  target="_blank"
  rel="noopener"
  aria-label={`${typeLabel} ${number}: ${title} (${stateLabel})`}
>
  <span class="github-card-icon" aria-hidden="true">
    {
      type === 'issue' ? (
        <svg viewBox="0 0 16 16">
          <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
          <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z" />
        </svg>
      ) : (
        <svg viewBox="0 0 16 16">
          <path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z" />
        </svg>
      )
    }
  </span>

  <span class="github-card-content">
    <div class="text-pretty">
      <span class="fg-3">#{number}</span> <strong>{title}</strong>
    </div>
    <span class="github-card-meta">
      <span class="badge">{stateLabel}</span>
      <!-- <span>{repo}</span> -->
      <!-- <span aria-hidden="true">·</span> -->
      <time datetime={openedAt}>Opened {openedDate}</time>
      {
        comments !== undefined && (
          <>
            <span aria-hidden="true">·</span>
            <span class="github-card-comments" aria-label={`${comments} ${comments === 1 ? 'comment' : 'comments'}`}>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M1 2.75C1 1.784 1.784 1 2.75 1h10.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 13.25 12H9.06l-2.573 2.573A1.458 1.458 0 0 1 4 13.543V12H2.75A1.75 1.75 0 0 1 1 10.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h2a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h4.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z" />
              </svg>
              {comments}
            </span>
          </>
        )
      }
    </span>
  </span>

</a>

<style>
  .github-card {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    gap: .75rem;
    align-items: start;
    width: 100%;
    padding: 1rem;
    line-height: 20px;
    color: inherit;
    text-decoration: none;
    background: var(--bs-bg-body);
    border: 1px solid var(--bs-border-color);
    border-radius: var(--bs-radius-7);
    box-shadow: var(--bs-box-shadow-sm);
    transition: border-color .15s ease, box-shadow .15s ease, scale .15s ease;
  }

  .github-card:hover {
    scale: 1.01;
    box-shadow: var(--bs-box-shadow);
  }

  .github-card:focus-visible {
    outline: 0;
    border-color: var(--bs-primary-border);
    outline: 2px solid var(--bs-primary-focus-ring);
  }

  .github-card-icon {
    display: inline-flex;
    margin-top: 2px;
    color: var(--bs-theme-fg);
  }

  .github-card-icon svg,
  .github-card-comments svg {
    width: 1rem;
    height: 1rem;
    fill: currentcolor;
  }

  /* .github-card-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  } */

  .github-card-content {
    min-width: 0;
  }

  .github-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .375rem;
    margin-top: .375rem;
    color: var(--bs-fg-3);
    font-size: var(--bs-font-size-sm);
  }

  .github-card-comments {
    display: inline-flex;
    gap: .25rem;
    align-items: center;
  }

  .github-card-comments svg {
    width: .875rem;
    height: .875rem;
  }

  @media (max-width: 575.98px) {
    .github-card {
      grid-template-columns: 1.5rem minmax(0, 1fr);
    }

    .github-card > .badge {
      grid-column: 2;
      justify-self: start;
    }

    .github-card-heading {
      display: block;
    }

    .github-card-number {
      margin-inline-start: .25rem;
    }
  }
</style>
