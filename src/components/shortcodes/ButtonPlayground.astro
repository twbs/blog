---
import Example from './Example.astro'
import { themeColors, themeColorTitle } from '../../libs/theme-colors'

// Mirrors `$button-variants` and `$button-sizes` in Bootstrap 6's
// scss/buttons/_button.scss.
const variants = ['solid', 'outline', 'subtle', 'text']
const sizes = [
  { value: 'btn-xs', label: 'Extra small' },
  { value: 'btn-sm', label: 'Small' },
  { value: '', label: 'Medium' },
  { value: 'btn-lg', label: 'Large' }
]
const radii = [
  { value: '', label: 'Default' },
  { value: 'rounded-pill', label: 'Pill' },
  { value: 'rounded-0', label: 'Square' }
]

const buttons = [
  '<button type="button" class="btn-solid theme-primary">Button</button>',
  '<button type="button" class="btn-solid theme-primary">',
  '  <svg class="bi" aria-hidden="true"><use href="#bd-arrow-left"/></svg>',
  '  Left icon',
  '</button>',
  '<button type="button" class="btn-solid theme-primary">',
  '  Right icon',
  '  <svg class="bi" aria-hidden="true"><use href="#bd-arrow-right"/></svg>',
  '</button>',
  '<button type="button" class="btn-solid btn-icon theme-primary" aria-label="Add">',
  '  <svg class="bi" aria-hidden="true"><use href="#bd-plus"/></svg>',
  '</button>'
]
---

<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
  <symbol id="bd-arrow-left" viewBox="0 0 16 16">
    <path
      fill-rule="evenodd"
      d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
    ></path>
  </symbol>
  <symbol id="bd-arrow-right" viewBox="0 0 16 16">
    <path
      fill-rule="evenodd"
      d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"
    ></path>
  </symbol>
  <symbol id="bd-plus" viewBox="0 0 16 16">
    <path
      fill-rule="evenodd"
      d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"
    ></path>
  </symbol>
</svg>

<div class="bd-playground not-prose" data-button-playground>
  <div class="bd-playground-controls bg-1 p-3 fs-sm">
    <div class="d-flex flex-wrap gap-3">
      <div class="vstack gap-1 flex-grow-0">
        <label class="form-label fw-semibold mb-0" for="bd-btn-color">Color</label>
        <select class="form-control form-control-sm" id="bd-btn-color" data-control="color">
          {themeColors.map(color => <option value={color}>{themeColorTitle(color)}</option>)}
        </select>
      </div>

      <div class="vstack gap-1 flex-grow-0">
        <span class="form-label fw-semibold mb-0">Variant</span>
        <div class="btn-group btn-group-sm text-capitalize" role="group" aria-label="Button variant">
          {
            variants.map(variant => (
              <label class="btn-check btn-outline theme-secondary">
                <input type="radio" name="bd-btn-variant" value={variant} checked={variant === 'solid'} />
                {variant}
              </label>
            ))
          }
        </div>
      </div>

      <div class="vstack gap-1 flex-grow-0">
        <label class="form-label fw-semibold mb-0" for="bd-btn-size">Size</label>
        <select class="form-control form-control-sm" id="bd-btn-size" data-control="size">
          {sizes.map(size => <option value={size.value} selected={size.value === ''}>{size.label}</option>)}
        </select>
      </div>

      <div class="vstack gap-1 flex-grow-0">
        <span class="form-label fw-semibold mb-0">Corners</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="Button corners">
          {
            radii.map(radius => (
              <label class="btn-check btn-outline theme-secondary">
                <input type="radio" name="bd-btn-radius" value={radius.value} checked={radius.value === ''} />
                {radius.label}
              </label>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <Example id="bd-button-preview" class="d-flex flex-wrap align-items-center gap-2" code={buttons} />
</div>

<script>
  const playground = document.querySelector<HTMLElement>('[data-button-playground]')

  if (playground) {
    const preview = playground.querySelector<HTMLElement>('#bd-button-preview')
    const previewButtons = [...(preview?.querySelectorAll<HTMLElement>('button') ?? [])]

    // Shiki emits each attribute value as a single span, so the class lists in
    // the source listing can be rewritten in place. That keeps the highlighting
    // intact without shipping the highlighter to the browser.
    const classSpans = [
      ...(playground
        .querySelector('.bd-example-snippet .astro-code')
        ?.querySelectorAll<HTMLElement>('span') ?? [])
    ].filter(span => /^"btn-/.test(span.textContent ?? ''))

    const colorSelect = playground.querySelector<HTMLSelectElement>('[data-control="color"]')
    const sizeSelect = playground.querySelector<HTMLSelectElement>('[data-control="size"]')

    const checked = (name: string) =>
      playground.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? ''

    function update() {
      const color = colorSelect?.value ?? 'primary'
      const variant = checked('bd-btn-variant') || 'solid'
      const size = sizeSelect?.value ?? ''
      const radius = checked('bd-btn-radius')

      previewButtons.forEach((button, index) => {
        // `btn-icon` is part of the example rather than something the controls
        // set, so it has to survive the rebuild.
        const isIconOnly = button.classList.contains('btn-icon')

        const classes = [`btn-${variant}`, isIconOnly ? 'btn-icon' : '', `theme-${color}`, size, radius].filter(Boolean)

        button.className = classes.join(' ')

        if (classSpans[index]) {
          classSpans[index].textContent = `"${classes.join(' ')}"`
        }
      })
    }

    playground.querySelectorAll('select, input[type="radio"]').forEach(control => {
      control.addEventListener('change', update)
    })

    update()
  }
</script>
