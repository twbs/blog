---
import SharedFooter from "@twbs/docs-ui/components/Footer";
import type { FooterColumn } from "@twbs/docs-ui";
import { getConfig } from "../../libs/config";

const site = getConfig();
const columns: FooterColumn[] = [
  {
    title: "Links",
    links: [
      { label: "All posts", href: "/" },
      { label: "Archive", href: "/archive/" },
      { label: "RSS feed", href: "/feed.xml" },
      { label: "Home", href: `${site.main}/` },
      { label: "Docs", href: `${site.main}/docs/${site.docs_version}/` },
      {
        label: "Examples",
        href: `${site.main}/docs/${site.docs_version}/examples/`,
      },
      { label: "Icons", href: site.icons },
      { label: "Swag Store", href: site.swag, external: true },
    ],
  },
  {
    title: "Guides",
    links: [
      {
        label: "Getting started",
        href: `${site.main}/docs/${site.docs_version}/getting-started/`,
      },
      {
        label: "Starter template",
        href: `${site.main}/docs/${site.docs_version}/examples/starter-template/`,
      },
      {
        label: "Webpack",
        href: `${site.main}/docs/${site.docs_version}/guides/webpack/`,
      },
      {
        label: "Parcel",
        href: `${site.main}/docs/${site.docs_version}/guides/parcel/`,
      },
      {
        label: "Vite",
        href: `${site.main}/docs/${site.docs_version}/guides/vite/`,
      },
    ],
  },
  {
    title: "Projects",
    links: [
      {
        label: "Bootstrap 6",
        href: `${site.github_org}/bootstrap`,
        external: true,
      },
      {
        label: "Bootstrap 5",
        href: `${site.github_org}/bootstrap/tree/v5-dev`,
        external: true,
      },
      { label: "Icons", href: `${site.github_org}/icons`, external: true },
      {
        label: "Examples repo",
        href: `${site.github_org}/examples`,
        external: true,
      },
    ],
  },
  {
    title: "Community",
    links: [
      {
        label: "Issues",
        href: `${site.github_org}/bootstrap/issues`,
        external: true,
      },
      {
        label: "Discussions",
        href: `${site.github_org}/bootstrap/discussions`,
        external: true,
      },
      {
        label: "Corporate sponsors",
        href: "https://github.com/sponsors/twbs",
        external: true,
      },
      { label: "Open Collective", href: site.opencollective, external: true },
      {
        label: "Stack Overflow",
        href: "https://stackoverflow.com/questions/tagged/bootstrap-5",
        external: true,
      },
    ],
  },
];
---

<SharedFooter brand="Bootstrap" columns={columns}>
  <ul class="list-unstyled small">
    <li class="mb-2">
      Designed and built with all the love in the world by the <a
        href={`${site.main}/docs/${site.docs_version}/about/team/`}
        >Bootstrap team</a
      > with the help of <a href={`${site.repo}/graphs/contributors`}
        >our contributors</a
      >.
    </li>
    <li class="mb-2">
      Code licensed <a
        href={`${site.repo}/blob/main/LICENSE`}
        target="_blank"
        rel="license noopener">MIT</a
      >, docs <a
        href="https://creativecommons.org/licenses/by/3.0/"
        target="_blank"
        rel="license noopener">CC BY 3.0</a
      >.
    </li>
  </ul>
</SharedFooter>
