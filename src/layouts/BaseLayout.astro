---
import Head from "../components/head/Head.astro";
import Navigation from "../components/header/Navigation.astro";
import Ads from "../components/Ads.astro";
import Footer from "../components/footer/Footer.astro";
import SharedBaseLayout from "@twbs/docs-ui/components/BaseLayout";

import type { HTMLAttributes } from "astro/types";

import type { SocialCard } from "../libs/social";

import "../assets/scss/style.scss";

interface ExtraScript {
  src: string;
  async?: boolean;
  defer?: boolean;
  integrity?: string;
}

interface Props {
  title: string;
  description?: string;
  card?: SocialCard;
  robots?: string;
  extraJs?: ExtraScript[];
  // Full-bleed layout without the ad sidebar. Pages that opt in (e.g. the blog
  // index) place the ad themselves.
  wide?: boolean;
  // For page-level behavior that has to hang off `<body>`, e.g. ScrollSpy.
  bodyAttrs?: HTMLAttributes<"body">;
}

const {
  title,
  description,
  card,
  robots,
  extraJs = [],
  wide = false,
  bodyAttrs,
} = Astro.props;
---

<SharedBaseLayout bodyAttrs={bodyAttrs}>
  <Head
    slot="head"
    title={title}
    description={description}
    card={card}
    robots={robots}
  />
  <Navigation slot="header" />

  <div
    slot="main"
    class:list={[
      "container-xl xl:container py-4 px-5 px-xl-2 xl:px-2 bd-layout",
      { "bd-layout-wide": wide },
    ]}
  >
    <main class="bd-main" id="content"><slot /></main>
    {
      !wide && (
        <aside class="bd-aside">
          <Ads />
        </aside>
      )
    }
  </div>

  <Footer slot="footer" />
  <Fragment slot="scripts">
    <script src="../assets/js/application.js"></script>
    {
      extraJs.map((script) => (
        <script
          is:inline
          src={script.src}
          async={script.async}
          defer={script.defer}
          integrity={script.integrity}
          crossorigin={script.integrity ? "anonymous" : undefined}
        />
      ))
    }
  </Fragment>
</SharedBaseLayout>
