---
import Head from '../components/head/Head.astro'
import Navigation from '../components/header/Navigation.astro'
import Ads from '../components/Ads.astro'
import Footer from '../components/footer/Footer.astro'
import Shell from '@twbs/docs-ui/components/Shell'

import type { HTMLAttributes } from 'astro/types'

import type { SocialCard } from '../libs/social'

import '../assets/scss/style.scss'

interface ExtraScript {
  src: string
  async?: boolean
  defer?: boolean
  integrity?: string
}

interface Props {
  title: string
  description?: string
  card?: SocialCard
  robots?: string
  extraJs?: ExtraScript[]
  // Full-bleed layout without the ad sidebar. Pages that opt in (e.g. the blog
  // index) place the ad themselves.
  wide?: boolean
  // For page-level behavior that has to hang off `<body>`, e.g. ScrollSpy.
  bodyAttrs?: HTMLAttributes<'body'>
}

const { title, description, card, robots, extraJs = [], wide = false, bodyAttrs } = Astro.props
---

<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <Head title={title} description={description} card={card} robots={robots} />
  </head>
  <Shell variant={wide ? 'wide' : 'narrow'} bodyAttrs={bodyAttrs}>
    <Navigation slot="header" />
    <slot />
    {!wide && <Ads slot="aside" />}
    <Footer slot="footer" />
    <Fragment slot="scripts">
      <script is:inline src="/assets/js/bootstrap.bundle.min.js"></script>
      <script src="../assets/js/application.js"></script>
      <script>
        import initSearch from '@twbs/docs-ui/browser/search'

        initSearch()
      </script>
      {
        extraJs.map((script) => (
          <script
            is:inline
            src={script.src}
            async={script.async}
            defer={script.defer}
            integrity={script.integrity}
            crossorigin={script.integrity ? 'anonymous' : undefined}
          />
        ))
      }
    </Fragment>
  </Shell>
</html>
