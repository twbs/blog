---
import Head from '../components/head/Head.astro'
import Symbols from '../components/Symbols.astro'
import Navigation from '../components/header/Navigation.astro'
import Ads from '../components/Ads.astro'
import Footer from '../components/footer/Footer.astro'

import type { SocialCard } from '../libs/social'

import '../assets/scss/style.scss'

interface ExtraScript {
  src: string
  async?: boolean
  defer?: boolean
  integrity?: string
}

interface Props {
  title: string
  description?: string
  card?: SocialCard
  robots?: string
  extraJs?: ExtraScript[]
  // Full-bleed layout without the ad sidebar. Pages that opt in (e.g. the blog
  // index) place the ad themselves.
  wide?: boolean
}

const { title, description, card, robots, extraJs = [], wide = false } = Astro.props
---

<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <Head title={title} description={description} card={card} robots={robots} />
  </head>
  <body>
    <Symbols />

    <div class="navbar-translucent sticky-top bd-sticky-navbar">
      <Navigation />
    </div>

    <div class:list={['xl:container py-4 px-4 xl:px-2 bd-layout', { 'bd-layout-wide': wide }]}>
      <main class="bd-main" id="content">
        <slot />
      </main>
      {
        !wide && (
          <aside class="bd-aside">
            <Ads />
          </aside>
        )
      }
    </div>

    <Footer />

    <script is:inline src="/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/application.js"></script>
    <script>
      import initSearch from '../assets/js/search.js'

      initSearch()
    </script>
    {
      extraJs.map((script) => (
        <script
          is:inline
          src={script.src}
          async={script.async}
          defer={script.defer}
          integrity={script.integrity}
          crossorigin={script.integrity ? 'anonymous' : undefined}
        />
      ))
    }
  </body>
</html>
