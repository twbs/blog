---
import BaseLayout from '../layouts/BaseLayout.astro'
import { sortedPosts, getPostSlug, formatDateShort } from '../libs/content'

const videoPosts = sortedPosts.filter(post => post.data.video)
---

<BaseLayout title="Videos" description="Every music video from Bootstrap Blog posts">
  {videoPosts.length > 0 && (
    <div class="row my-5">
      {videoPosts.map(post => (
        <div class="sm:col-6 md:col-4 mb-4">
          <div class="ratio">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${post.data.video}?rel=0${post.data.video_start ? `&start=${post.data.video_start}` : ''}`}
              class="d-block w-100 ratio-16x9"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              title="YouTube Video"
              loading="lazy"
            ></iframe>
          </div>
          <h2 class="h5 mb-0">
            <a href={`/${getPostSlug(post)}/`}>{post.data.title}</a>
          </h2>
          <small class="fg-2">{formatDateShort(new Date(post.data.date))}</small>
        </div>
      ))}
    </div>
  )}
</BaseLayout>
